{
  "appId": "com.domainmarketplace.galacticraider",
  "appName": "Galactic Raider",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "backgroundColor": "#0F172A",
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0F172A",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
