# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#
# Only publishable/anon keys belong here — anything prefixed with VITE_ is bundled
# into the client and is publicly visible. Secret keys (e.g. the Supabase
# service-role key) must ONLY ever live on a server, never in this app.

# --- Supabase (real authentication + database) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# --- Quest SDK (Help Hub) — publishable client keys ---
VITE_QUEST_HELP_QUESTID=
VITE_QUEST_USER_ID=
VITE_QUEST_APIKEY=
VITE_QUEST_ENTITYID=
