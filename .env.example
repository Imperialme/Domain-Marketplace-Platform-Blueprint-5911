# ── Copy this to .env.local for local dev ──────────────────────────────────
# In Netlify: Site Settings → Environment Variables → Add these

# Your email — where inquiry notifications go
VITE_ADMIN_EMAIL=mail@shahid.me

# ── EmailJS (free at emailjs.com — 200 emails/month) ───────────────────────
# 1. Sign up at https://emailjs.com
# 2. Add a service (connect your Gmail under Email Services)
# 3. Create Template 1 (admin notification) — copy the template from README
# 4. Create Template 2 (buyer confirmation) — copy the template from README
# 5. Get your Public Key from Account → API Keys

VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ADMIN=template_xxxxxxx
VITE_EMAILJS_TEMPLATE_BUYER=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxx
