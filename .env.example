# ── Copy this to .env.local for local dev ──────────────────────────────────
# In Netlify: Site Settings → Environment Variables → Add these

# Your email — where inquiry notifications go
VITE_ADMIN_EMAIL=mail@shahid.me

# ── Mailgun (transactional email) ───────────────────────────────────────────
# 1. Log in at https://app.mailgun.com
# 2. Sending → Domains — use sandbox or add your sending domain
# 3. Settings → API Keys → copy your Private API Key
#
# NOTE: No VITE_ prefix — these are server-side only (Netlify Function).
# They are never exposed to the browser.

MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAILGUN_DOMAIN=mg.yourdomain.com

# EU Mailgun accounts only — omit for US (default)
# MAILGUN_REGION=eu
